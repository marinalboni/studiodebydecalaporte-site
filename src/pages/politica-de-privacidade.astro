---
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../config/site";
import copy from "../content/copy";
import { fill } from "../lib/fill";
import { parseRichText } from "../lib/richtext";

const tokens = {
  businessName: site.business.name,
  ownerName: site.about.ownerName,
  phoneDisplay: site.contact.phoneDisplay,
};
const title = fill(copy.pages.privacy.title, tokens);
const description = fill(copy.pages.privacy.description, tokens);

const updatedDate = copy.pages.privacy.updatedDate;
// Parsed and formatted in UTC so the day never shifts with the build machine's timezone.
const lastUpdated = new Intl.DateTimeFormat(site.locale, { dateStyle: "long", timeZone: "UTC" }).format(
  new Date(`${updatedDate}T00:00:00Z`),
);
---

<BaseLayout title={title} description={description} includeStructuredData={false}>
  <article class="container privacy">
    <h1>{copy.pages.privacy.heading}</h1>
    <p class="privacy__updated">
      {copy.pages.privacy.updatedLabel}: <time datetime={updatedDate}>{lastUpdated}</time>
    </p>
    <p class="privacy__intro">{copy.pages.privacy.intro}</p>

    {
      copy.pages.privacy.sections.map((section) => (
        <section>
          <h2>{section.heading}</h2>
          {parseRichText(fill(section.body, tokens)).map((segments) => (
            <p>
              {segments.map((segment) =>
                segment.href ? (
                  <a href={segment.href} target="_blank" rel="noopener noreferrer">
                    {segment.text}
                  </a>
                ) : segment.bold ? (
                  <strong>{segment.text}</strong>
                ) : (
                  segment.text
                ),
              )}
            </p>
          ))}
        </section>
      ))
    }
  </article>
</BaseLayout>

<style>
  .privacy {
    padding-block: var(--space-2xl);
    max-width: var(--container-width-sm);
  }

  .privacy__updated {
    color: var(--color-text-muted);
    font-size: var(--step--1);
    margin-bottom: var(--space-md);
  }

  .privacy__intro {
    margin-bottom: var(--space-lg);
  }

  .privacy section {
    margin-top: var(--space-lg);
  }

  .privacy section p {
    margin-top: var(--space-2xs);
    color: var(--color-text-muted);
  }
</style>
