---
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../config/site";
import copy from "../content/copy";
import { fill } from "../lib/fill";
import Button from "../components/ui/Button.astro";
import WhatsAppLink from "../components/ui/WhatsAppLink.astro";

const title = fill(copy.pages.obrigado.title, { businessName: site.business.name });
---

<BaseLayout
  title={title}
  description={copy.pages.obrigado.description}
  robots="noindex, follow"
  includeStructuredData={false}
>
  <section
    class="container obrigado"
    data-ficha-heading={copy.pages.obrigado.fichaHeading}
    data-ficha-body={copy.pages.obrigado.fichaBody}
  >
    <h1 class="obrigado__heading">{copy.pages.obrigado.heading}</h1>
    <p class="obrigado__body">{copy.pages.obrigado.body}</p>
    <div class="obrigado__actions">
      <Button href="/" variant="outline">{copy.pages.obrigado.backHomeCta}</Button>
      <WhatsAppLink message={site.contact.whatsappDefaultMessage}>
        {copy.pages.obrigado.whatsappCta}
      </WhatsAppLink>
    </div>
  </section>
</BaseLayout>

<script>
  // The anamnese form posts to /obrigado?ficha=1. Without JS the generic
  // thank-you text simply stays, which is still correct.
  const section = document.querySelector<HTMLElement>(".obrigado");
  if (section && new URLSearchParams(window.location.search).has("ficha")) {
    const heading = section.querySelector(".obrigado__heading");
    const body = section.querySelector(".obrigado__body");
    if (heading && section.dataset.fichaHeading) heading.textContent = section.dataset.fichaHeading;
    if (body && section.dataset.fichaBody) body.textContent = section.dataset.fichaBody;
  }
</script>

<style>
  .obrigado {
    padding-block: var(--space-3xl);
    max-width: var(--container-width-sm);
    text-align: center;
  }

  .obrigado p {
    margin-block: var(--space-md) var(--space-lg);
    color: var(--color-text-muted);
  }

  .obrigado__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
  }
</style>
