---
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../config/site";
import copy from "../content/copy";
import { fill } from "../lib/fill";
import Button from "../components/ui/Button.astro";
import WhatsAppLink from "../components/ui/WhatsAppLink.astro";

const title = fill(copy.pages.obrigado.title, { businessName: site.business.name });
---

<BaseLayout
  title={title}
  description={copy.pages.obrigado.description}
  robots="noindex, follow"
  includeStructuredData={false}
>
  <section class="container obrigado">
    <h1>{copy.pages.obrigado.heading}</h1>
    <p>{copy.pages.obrigado.body}</p>
    <div class="obrigado__actions">
      <Button href="/" variant="outline">{copy.pages.obrigado.backHomeCta}</Button>
      <WhatsAppLink message={site.contact.whatsappDefaultMessage}>
        {copy.pages.obrigado.whatsappCta}
      </WhatsAppLink>
    </div>
  </section>
</BaseLayout>

<style>
  .obrigado {
    padding-block: var(--space-3xl);
    max-width: var(--container-width-sm);
    text-align: center;
  }

  .obrigado p {
    margin-block: var(--space-md) var(--space-lg);
    color: var(--color-text-muted);
  }

  .obrigado__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
  }
</style>
