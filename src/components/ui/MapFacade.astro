---
import site from "../../config/site";
import copy from "../../content/copy";
import { fill } from "../../lib/fill";

const iframeTitle = fill(copy.location.mapFacade.iframeTitle, {
  businessName: site.business.name,
});
---

<div
  class="map-facade"
  data-embed-url={site.address.mapEmbedUrl}
  data-iframe-title={iframeTitle}
>
  <div class="map-facade__backdrop" aria-hidden="true"></div>
  <div class="map-facade__content">
    <p class="map-facade__body">{copy.location.mapFacade.body}</p>
    <a
      class="map-facade__action button button--primary"
      href={site.address.googleMapsUrl}
      rel="noopener noreferrer"
      target="_blank"
    >
      {copy.location.mapFacade.buttonLabel}
    </a>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>(".map-facade").forEach((facade) => {
    const action = facade.querySelector<HTMLAnchorElement>(".map-facade__action");
    const embedUrl = facade.dataset.embedUrl;
    const title = facade.dataset.iframeTitle ?? "";
    if (!action || !embedUrl) return;

    action.addEventListener(
      "click",
      (event) => {
        event.preventDefault();
        const iframe = document.createElement("iframe");
        iframe.src = embedUrl;
        iframe.title = title;
        iframe.loading = "lazy";
        iframe.referrerPolicy = "no-referrer-when-downgrade";
        iframe.className = "map-facade__iframe";
        facade.replaceChildren(iframe);
      },
      { once: true },
    );
  });
</script>

<style>
  .map-facade {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .map-facade__backdrop {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--color-secondary), var(--color-primary));
    opacity: 0.35;
  }

  .map-facade__content {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    padding: var(--space-lg);
    text-align: center;
  }

  .map-facade__body {
    max-width: 28ch;
    color: var(--color-text);
  }

  .map-facade__iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
</style>
