---
import site from "../../config/site";
import copy from "../../content/copy";
import { fill } from "../../lib/fill";

const iframeTitle = fill(copy.location.mapIframeTitle, {
  businessName: site.business.name,
});
---

<!-- loading="lazy": the browser fetches the map only as it nears the
     viewport, so it never slows down the top of the page. -->
<div class="map-embed">
  <iframe
    src={site.address.mapEmbedUrl}
    title={iframeTitle}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
  ></iframe>
</div>

<style>
  .map-embed {
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .map-embed iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
