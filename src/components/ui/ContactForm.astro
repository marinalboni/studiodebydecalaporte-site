---
import site from "../../config/site";
import copy from "../../content/copy";
import Button from "./Button.astro";

const { form } = copy.contact;
const isFormspree = site.form.provider === "formspree";
const action = isFormspree
  ? `https://formspree.io/f/${site.form.formspreeId ?? ""}`
  : site.form.successPath;
const honeypotName = isFormspree ? "_gotcha" : "bot-field";
---

<form
  name="contato"
  method="POST"
  action={action}
  data-netlify={isFormspree ? undefined : "true"}
  netlify-honeypot={isFormspree ? undefined : "bot-field"}
  class="contact-form"
>
  {!isFormspree && <input type="hidden" name="form-name" value="contato" />}
  {isFormspree && (
    <input type="hidden" name="_next" value={`${site.siteUrl}${site.form.successPath}`} />
  )}

  <p class="contact-form__honeypot" aria-hidden="true">
    <label for="contact-botfield">{form.honeypotLabel}</label>
    <input id="contact-botfield" type="text" name={honeypotName} tabindex="-1" autocomplete="off" />
  </p>

  <div class="contact-form__field">
    <label for="contact-name">{form.nameLabel}</label>
    <input
      id="contact-name"
      name="nome"
      type="text"
      autocomplete="name"
      placeholder={form.namePlaceholder}
      required
      aria-required="true"
      aria-describedby="contact-name-error"
      data-error-message={form.requiredError}
    />
    <span id="contact-name-error" class="contact-form__error" role="alert"></span>
  </div>

  <div class="contact-form__field">
    <label for="contact-phone">{form.phoneLabel}</label>
    <input
      id="contact-phone"
      name="telefone"
      type="tel"
      inputmode="numeric"
      pattern="[0-9]{9,}"
      minlength="9"
      autocomplete="tel"
      placeholder={form.phonePlaceholder}
      required
      aria-required="true"
      aria-describedby="contact-phone-error"
      data-error-message={form.invalidPhoneError}
    />
    <span id="contact-phone-error" class="contact-form__error" role="alert"></span>
  </div>

  <div class="contact-form__field">
    <label for="contact-email">
      {form.emailLabel} <span class="contact-form__optional">{form.emailOptionalNote}</span>
    </label>
    <input
      id="contact-email"
      name="email"
      type="email"
      autocomplete="email"
      placeholder={form.emailPlaceholder}
      aria-describedby="contact-email-error"
      data-error-message={form.invalidEmailError}
    />
    <span id="contact-email-error" class="contact-form__error" role="alert"></span>
  </div>

  <div class="contact-form__field">
    <label for="contact-service">{form.serviceLabel}</label>
    <select id="contact-service" name="servico">
      <option value="">{form.servicePlaceholder}</option>
      {
        site.services.categories.map((category) => {
          const options = category.items.map((service) => (
            <option value={service.name}>{service.name}</option>
          ));
          return category.title ? <optgroup label={category.title}>{options}</optgroup> : options;
        })
      }
      <option value={form.serviceOtherOption}>{form.serviceOtherOption}</option>
    </select>
  </div>

  <div class="contact-form__field">
    <label for="contact-message">{form.messageLabel}</label>
    <textarea
      id="contact-message"
      name="mensagem"
      rows="4"
      placeholder={form.messagePlaceholder}
    ></textarea>
  </div>

  <div class="contact-form__field contact-form__field--consent">
    <input
      id="contact-consent"
      name="consentimento"
      type="checkbox"
      value="sim"
      required
      aria-required="true"
      aria-describedby="contact-consent-error"
      data-error-message={form.consentRequiredError}
    />
    <label for="contact-consent">
      {form.consentLabelBefore}<a href="/politica-de-privacidade">{form.consentLinkText}</a>{form.consentLabelAfter}
    </label>
    <span id="contact-consent-error" class="contact-form__error" role="alert"></span>
  </div>

  <Button type="submit" class="contact-form__submit">{form.submitLabel}</Button>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>(".contact-form").forEach((formEl) => {
    const controls = formEl.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
      "input[required], textarea[required], input[type='email']",
    );

    controls.forEach((control) => {
      control.addEventListener("invalid", () => {
        const errorEl = document.getElementById(`${control.id}-error`);
        const message = control.dataset.errorMessage ?? "";
        if (errorEl) errorEl.textContent = message;
        control.setAttribute("aria-invalid", "true");
      });

      // Validate as soon as the visitor leaves the field, not only on submit.
      // checkValidity() fires the "invalid" handler above when needed. The
      // consent checkbox is skipped so tabbing past it doesn't flag it.
      if (control.type !== "checkbox") {
        control.addEventListener("blur", () => control.checkValidity());
      }

      control.addEventListener("input", () => {
        // Phone accepts digits only: drop anything else as it's typed or pasted.
        if (control.type === "tel") control.value = control.value.replace(/\D/g, "");
        if (control.validity.valid) {
          const errorEl = document.getElementById(`${control.id}-error`);
          if (errorEl) errorEl.textContent = "";
          control.removeAttribute("aria-invalid");
        }
      });
    });
  });
</script>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .contact-form__honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .contact-form__field label {
    font-weight: var(--weight-medium);
    font-size: var(--step--1);
  }

  .contact-form__optional {
    font-weight: var(--weight-regular);
    color: var(--color-text-muted);
  }

  .contact-form__field input,
  .contact-form__field select,
  .contact-form__field textarea {
    min-height: 44px;
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .contact-form__field textarea {
    min-height: 8rem;
    resize: vertical;
  }

  .contact-form__field input:invalid[aria-invalid="true"],
  .contact-form__field textarea:invalid[aria-invalid="true"] {
    border-color: var(--color-accent-text);
  }

  .contact-form__error {
    color: var(--color-accent-text);
    font-size: var(--step--1);
    min-height: 1.2em;
  }

  .contact-form__field--consent {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: var(--space-2xs) var(--space-xs);
  }

  .contact-form__field--consent input {
    min-height: 0;
    width: 20px;
    height: 20px;
    margin-top: 2px;
  }

  .contact-form__field--consent .contact-form__error {
    grid-column: 1 / -1;
  }

  .contact-form :global(.contact-form__submit) {
    align-self: flex-start;
  }
</style>
