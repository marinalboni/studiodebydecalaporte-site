---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import site from "../config/site";
import { buildStructuredData } from "../lib/schema";
import ogDefaultImage from "../assets/brand/og-default.jpg";

const heroImages = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/images/hero/*.{jpg,jpeg,png}",
  { eager: true },
);
const aboutImages = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/images/about/*.{jpg,jpeg,png}",
  { eager: true },
);

const ogImage = await getImage({ src: ogDefaultImage, width: 1200, height: 630, format: "jpg" });
const ogImageUrl = new URL(ogImage.src, site.siteUrl).toString();

async function resolveAbsolute(glob: Record<string, { default: ImageMetadata }>, file: string) {
  const entry = Object.entries(glob).find(([path]) => path.endsWith(file));
  if (!entry) return undefined;
  const optimized = await getImage({ src: entry[1].default, width: 1200 });
  return new URL(optimized.src, site.siteUrl).toString();
}

const photoUrls = (
  await Promise.all([
    resolveAbsolute(heroImages, site.images.hero.file),
    resolveAbsolute(aboutImages, site.images.about.file),
  ])
).filter((url): url is string => Boolean(url));

const structuredData = buildStructuredData(site, {
  ogImageUrl,
  // TODO: swap for a real raster logo URL once src/assets/brand/logo.svg is replaced with final branding.
  logoUrl: ogImageUrl,
  photoUrls,
});

// Escape "<" so a stray "</script>" inside any text field can't break out of the script tag.
const json = JSON.stringify(structuredData).replace(/</g, "\\u003c");
---

<script type="application/ld+json" set:html={json} />
