---
import site from "../../config/site";
import copy from "../../content/copy";
---

<section id="testimonials" aria-labelledby="testimonials-heading" class="testimonials">
  <div class="container">
    <p class="section-eyebrow">{copy.testimonials.eyebrow}</p>
    <h2 id="testimonials-heading">{copy.testimonials.heading}</h2>
    <p class="section-intro">{copy.testimonials.intro}</p>

    <ul class="testimonials__grid">
      {
        site.testimonials.map((testimonial) => (
          <li class="testimonial-card">
            <blockquote>
              <p>&ldquo;{testimonial.text}&rdquo;</p>
            </blockquote>
            <footer>
              <cite>{testimonial.author}</cite>
              <span class="testimonial-card__source">{copy.testimonials.sourceLabel}</span>
            </footer>
          </li>
        ))
      }
    </ul>

    {
      site.social.googleBusinessProfileUrl && (
        <div class="testimonials__ctas">
          <a href={site.social.googleBusinessProfileUrl} rel="noopener noreferrer" target="_blank">
            {copy.testimonials.ctaSeeAll}
          </a>
          <a href={site.social.googleBusinessProfileUrl} rel="noopener noreferrer" target="_blank">
            {copy.testimonials.ctaLeaveReview}
          </a>
        </div>
      )
    }
  </div>
</section>

<style>
  .testimonials {
    padding-block: var(--space-2xl);
  }

  .testimonials__grid {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    margin-top: var(--space-md);
  }

  .testimonial-card {
    padding: var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .testimonial-card blockquote {
    margin: 0 0 var(--space-sm);
    font-style: italic;
  }

  .testimonial-card footer {
    display: flex;
    flex-direction: column;
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  .testimonial-card cite {
    font-style: normal;
    font-weight: var(--weight-medium);
  }

  .testimonials__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-lg);
    font-weight: var(--weight-medium);
  }
</style>
