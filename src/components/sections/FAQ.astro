---
import { publishedFaq } from "../../config/site";
import copy from "../../content/copy";
---

<section id="faq" aria-labelledby="faq-heading" class="faq">
  <div class="container">
    <p class="section-eyebrow">{copy.faq.eyebrow}</p>
    <h2 id="faq-heading">{copy.faq.heading}</h2>
    <p class="section-intro">{copy.faq.intro}</p>

    <div class="faq__list">
      {
        publishedFaq.map((item) => (
          <details class="faq__item">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    padding-block: var(--space-2xl);
  }

  .faq__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-top: var(--space-md);
  }

  .faq__item {
    padding: var(--space-sm) var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .faq__item summary {
    cursor: pointer;
    font-weight: var(--weight-medium);
    font-size: var(--step-0);
  }

  .faq__item p {
    margin-top: var(--space-xs);
    color: var(--color-text-muted);
  }
</style>
