---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import site from "../../config/site";
import copy from "../../content/copy";
import { resolveImage } from "../../lib/images";

const galleryImages = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/images/gallery/*.{jpg,jpeg,png}",
  { eager: true },
);

const photos = await Promise.all(
  site.images.gallery.map(async (entry) => {
    const source = resolveImage(galleryImages, entry.file);
    if (!source) return null;
    const thumb = await getImage({ src: source, width: 600, height: 750, format: "webp" });
    const full = await getImage({ src: source, width: 1400 });
    return { thumb, full, alt: entry.alt };
  }),
);
const validPhotos = photos.filter((photo): photo is NonNullable<typeof photo> => photo !== null);
---

<section id="gallery" aria-labelledby="gallery-heading" class="gallery">
  <div class="container">
    <p class="section-eyebrow">{copy.gallery.eyebrow}</p>
    <h2 id="gallery-heading">{copy.gallery.heading}</h2>
    <p class="section-intro">{copy.gallery.intro}</p>

    <ul class="gallery__grid">
      {
        validPhotos.map((photo) => (
          <li>
            <a
              class="gallery__link"
              href={photo.full.src}
              data-full={photo.full.src}
              data-alt={photo.alt}
            >
              <img
                src={photo.thumb.src}
                width={photo.thumb.attributes.width}
                height={photo.thumb.attributes.height}
                alt={photo.alt}
                loading="lazy"
                decoding="async"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <dialog id="gallery-lightbox" class="gallery-lightbox" aria-label={copy.gallery.heading}>
    <button type="button" class="gallery-lightbox__close" data-action="close">
      <span class="sr-only">{copy.gallery.lightboxCloseLabel}</span>
      <span aria-hidden="true">&times;</span>
    </button>
    <button type="button" class="gallery-lightbox__nav gallery-lightbox__nav--prev" data-action="prev">
      <span class="sr-only">{copy.gallery.lightboxPrevLabel}</span>
      <span aria-hidden="true">&#8249;</span>
    </button>
    <img class="gallery-lightbox__image" alt="" />
    <button type="button" class="gallery-lightbox__nav gallery-lightbox__nav--next" data-action="next">
      <span class="sr-only">{copy.gallery.lightboxNextLabel}</span>
      <span aria-hidden="true">&#8250;</span>
    </button>
  </dialog>
</section>

<script>
  const dialog = document.getElementById("gallery-lightbox") as HTMLDialogElement | null;
  const image = dialog?.querySelector<HTMLImageElement>(".gallery-lightbox__image");
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".gallery__link"));
  let current = 0;

  function show(index: number) {
    if (!image || links.length === 0) return;
    current = (index + links.length) % links.length;
    const link = links[current];
    image.src = link.dataset.full ?? link.href;
    image.alt = link.dataset.alt ?? "";
  }

  if (dialog && typeof dialog.showModal === "function") {
    links.forEach((link, index) => {
      link.addEventListener("click", (event) => {
        event.preventDefault();
        show(index);
        dialog.showModal();
      });
    });

    dialog.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (target === dialog) {
        dialog.close();
        return;
      }
      const action = target.closest<HTMLElement>("[data-action]")?.dataset.action;
      if (action === "close") dialog.close();
      if (action === "next") show(current + 1);
      if (action === "prev") show(current - 1);
    });

    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") show(current + 1);
      if (event.key === "ArrowLeft") show(current - 1);
    });
  }
</script>

<style>
  .gallery {
    padding-block: var(--space-2xl);
  }

  .gallery__grid {
    display: grid;
    gap: var(--space-sm);
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    margin-top: var(--space-md);
  }

  .gallery__link {
    display: block;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .gallery__link img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform var(--transition-normal) var(--ease-standard);
  }

  .gallery__link:hover img {
    transform: scale(1.03);
  }

  /* margin: auto restores the browser's centering of a modal <dialog>,
     which the global `* { margin: 0 }` reset removes. */
  .gallery-lightbox {
    margin: auto;
    border: none;
    padding: 0;
    background: transparent;
    max-width: min(90vw, 56rem);
    max-height: 90vh;
  }

  .gallery-lightbox::backdrop {
    background: rgba(0, 0, 0, 0.8);
  }

  .gallery-lightbox__image {
    display: block;
    max-width: 100%;
    max-height: 90vh;
    margin-inline: auto;
    border-radius: var(--radius-md);
  }

  .gallery-lightbox__close,
  .gallery-lightbox__nav {
    position: fixed;
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.9);
    border-radius: var(--radius-full);
    font-size: var(--step-2);
  }

  .gallery-lightbox__close {
    top: var(--space-md);
    right: var(--space-md);
  }

  .gallery-lightbox__nav--prev {
    left: var(--space-md);
    top: 50%;
    transform: translateY(-50%);
  }

  .gallery-lightbox__nav--next {
    right: var(--space-md);
    top: 50%;
    transform: translateY(-50%);
  }
</style>
